{
  "expo": {
    "name": "Dina Limpieza",
    "slug": "dina-limpieza",
    "scheme": "dinalimpieza",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4C81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dina.limpieza",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos la cámara para escanear los códigos QR de cada habitación.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación al hacer check-in para verificar que estás en el edificio."
      }
    },
    "android": {
      "package": "com.dina.limpieza",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F4C81"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a Dina Limpieza usar la cámara para escanear QR."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Usamos tu ubicación al hacer check-in para verificar que estás en el edificio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F4C81"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "auth0Domain": "AUTH0_DOMAIN_PLACEHOLDER",
      "auth0ClientId": "AUTH0_CLIENT_ID_PLACEHOLDER",
      "auth0Audience": "AUTH0_AUDIENCE_PLACEHOLDER",
      "supabaseUrl": "SUPABASE_URL_PLACEHOLDER",
      "supabaseAnonKey": "SUPABASE_ANON_KEY_PLACEHOLDER"
    }
  }
}
